# Required
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Optional (defaults in brackets)
EBA_SCHEMA=public                 # [public] schema of the application tables
EBA_STORAGE=storage               # [storage] folder of the immutable original files
EBA_MAX_MB=100                    # [100] largest accepted upload, in MB
EBA_USER_ID=                      # author recorded for imports until authentication exists
EBA_UI_DIR=                       # folder with the built interface, served by the API at /
EBA_CORS_ORIGINS=                 # comma-separated origins allowed to call the API from a browser
