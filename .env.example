DATABASE_URL=postgresql://localhost:5432/eba
# PostgreSQL database used by the application.
TEST_DATABASE_URL=postgresql://localhost:5432/eba_test
# PostgreSQL database used by the test suite.
EBA_STORAGE=storage
# Immutable uploaded-file storage directory.
EBA_SCHEMA=public
# Application schema name.
EBA_MAX_MB=100
# Maximum upload size in megabytes.
EBA_USER_ID=
# Default import author identifier.
EBA_UI_DIR=
# Optional built UI directory.
EBA_CORS_ORIGINS=
# Comma-separated browser origins.
EBA_DROP_STAGING_AFTER_LOAD=true
# Whether successful loads remove staging tables.
